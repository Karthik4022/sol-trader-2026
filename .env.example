# ===== Solana Trading Bot 2026 - configuration =====

# --- RPC ---
# Your private/fast RPC (Helius, Triton, QuickNode, Alchemy...).
# IMPORTANT: for sniping speed do NOT rely on the public endpoint.
RPC_URL=https://api.mainnet-beta.solana.com
# WebSocket endpoint of the same provider (leave empty to auto-derive)
WS_URL=

# --- Wallet ---
# Base58 private key of the trading wallet. Generate with: npm run build && node dist/main.js wallet new
WALLET_PRIVATE_KEY=
# How many lamports (=1e-9 SOL) to spend per snipe buy in SOL (e.g. 200000000 = 0.2 SOL)
SNIPE_BUDGET_SOL=0.2
# Slippage in % for swaps (default 15 for meme tokens)
SLIPPAGE_PCT=15

# --- Fees / priority ---
# Jupiter prioritization: auto | low | medium | high | veryHigh
PRIORITY_LEVEL=high
# Hard cap for priority fee in lamports (1 SOL = 1e9 lamports)
MAX_PRIORITY_FEE_LAMPORTS=2500000
# Jito tip in SOL (0 = disabled). Used for snipes when set > 0.
JITO_TIP_SOL=0

# --- Safety filters (skip tokens that fail any active check) ---
SAFETY_MINT_AUTHORITY_OFF=true
SAFETY_FREEZE_AUTHORITY_OFF=true
SAFETY_MAX_HOLDER_PCT=30
SAFETY_REQUIRE_RENOUNCED=false

# --- Sniper ---
# 1 = PumpPortal public websocket (fastest, recommended)
# 2 = raw RPC logsSubscribe on the Pump.fun program (no external service)
SNIPER_FEED=1
PUMPPORTAL_URL=wss://pumpportal.fun/api/data
# Only buy when dev SOL funding <= this value (SOL) - 0 disables the filter
SNIPER_MAX_DEV_FUNDING=0
# Cooldown ms between snipes
SNIPER_COOLDOWN_MS=2000

# --- Copy trading ---
# Wallets to mirror (comma separated), e.g. 4x...pubkey1,4x...pubkey2
COPY_TRADE_WALLETS=
# Multiply the copied position size. 1 = same SOL size, 0.5 = half
COPY_TRADE_SIZE_MULT=0.25
# Minimum copied buy in SOL to act on
COPY_TRADE_MIN_SOL=0.01
# Mirror target-wallet sells (false by default for safety)
COPY_TRADE_AUTO_SELL=true
# Percentage of your token holdings sold when a target wallet sells
COPY_TRADE_SELL_PCT=100

# --- Limit orders / TP / SL ---
# Store file for open orders
ORDERS_FILE=data/orders.json
# How often (ms) prices are re-checked for open orders
ORDER_POLL_MS=4000

# --- Telegram remote control (optional; commands: buy/sell/snipe/copy/status) ---
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- Jupiter Swap API ---
# Free: lite-api.jup.ag/swap/v1   (no key). Add x-api-key header via JUP_API_KEY if you have one.
JUP_API_BASE=https://lite-api.jup.ag/swap/v1
JUP_API_KEY=
